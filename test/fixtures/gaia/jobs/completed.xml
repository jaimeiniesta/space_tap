<uws:parameter id="query"><![CDATA[SELECT TOP 5 source_id, designation, ra, dec, parallax, phot_g_mean_mag FROM gaiadr3.gaia_source WHERE CONTAINS(POINT('ICRS', ra, dec), CIRCLE('ICRS', 56.75, 24.12, 1.0)) = 1 AND parallax IS NOT NULL AND phot_g_mean_mag IS NOT NULL ORDER BY phot_g_mean_mag]]></uws:parameter>
<uws:parameter id="query_sql_translated"><![CDATA[SELECT gaiadr3.gaia_source."source_id" AS "source_id" , gaiadr3.gaia_source."designation" AS "designation" , gaiadr3.gaia_source."ra" AS "ra" , gaiadr3.gaia_source."dec" AS "dec" , gaiadr3.gaia_source."parallax" AS "parallax" , gaiadr3.gaia_source."phot_g_mean_mag" AS "phot_g_mean_mag"
FROM gaiadr3.gaia_source
WHERE (q3c_join(56.75,24.12,gaiadr3.gaia_source."ra",gaiadr3.gaia_source."dec",1.0)) = '1' AND gaiadr3.gaia_source."parallax" IS NOT NULL AND gaiadr3.gaia_source."phot_g_mean_mag" IS NOT NULL
ORDER BY gaiadr3.gaia_source."phot_g_mean_mag" ASC
Limit 5]]></uws:parameter>
